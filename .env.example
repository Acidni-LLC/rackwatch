# Copy to .env and fill in. Never commit .env.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
ASR_MODEL=muse-voice-transcribe-1.0
ASR_URL=https://api.meta.ai/v1/asr/transcribe
META_MODE=live            # live | record | replay (replay is automatic if MODEL_API_KEY is empty)
BUDGET_USD_TOTAL=120
BUDGET_USD_PER_RUN=1.50
MAX_TOKENS_PER_RUN=600000
PRICE_IN_PER_M=1.25
PRICE_CACHED_PER_M=0.15
PRICE_OUT_PER_M=4.25
# Stretch only
FIREWORKS_API_KEY=
